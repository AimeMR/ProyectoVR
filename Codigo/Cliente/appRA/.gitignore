# =========================================================
# Unity.gitignore - Plantilla oficial de GitHub para Unity
# =========================================================

# Unity generated
Library/
Temp/
Obj/
Build/
Builds/
Logs/
UserSettings/
MemorySegments.csv
AssetImportErrors.log
AssetImportWarnings.log
AssetImportTimeline.json
AssetBundleManifest.json
ScriptCompilation.json
PackageImportTimings.txt
GeneratedVirtualTexts/
.terraform/

# Autogenerated VS/MD project files
ExportedObj/
.consulo/
.idea/
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db
*.VC.VC.opendb

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity Asset Store files
.assetstore/

# Packed Asset files (compiled for Unity)
*.unitypackage

# Builds
*.apk
*.aab
*.app
*.ipa
*.xapk
*.exe
*.msi
*.appx
*.xap
*.wasm
*.html
*.js
*.dat
*.json
*.webgl
*.webgl.zip

# Crashlytics generated
Assets/StreamingAssets/crashlytics-build-id.txt

# =========================================================
# macOS specific
# =========================================================
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*
.Spotlight-V100
.Trashes
__MACOSX

# =========================================================
# Windows specific
# =========================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# =========================================================
# JetBrains Rider
# =========================================================
.idea/
*.iml
*.ipr
*.iws

# =========================================================
# Visual Studio Code
# =========================================================
.vscode/

# =========================================================
# Other
# =========================================================
*~
*.log
*.bak
*.swp
*.swo